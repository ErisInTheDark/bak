# Copy to .env in this checkout. ${wb:KEY} values resolve from Workbench's store for this folder.
# Each backup folder chooses its bucket with `@remote = b2://bucket[/prefix]` in its .bakspec.
# Backup folders can override values here with `@env.NAME = value` in their .bakspec.
B2_APPLICATION_KEY_ID=${wb:B2_APPLICATION_KEY_ID}
B2_APPLICATION_KEY=${wb:B2_APPLICATION_KEY}
